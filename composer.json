{
  "require": {
    "symfony/routing": "^8.1",
    "symfony/http-foundation": "^8.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --testsuite Unit,Integration,Functional,E2E",
    "test:unit": "phpunit --testsuite Unit",
    "test:integration": "phpunit --testsuite Integration",
    "test:functional": "phpunit --testsuite Functional",
    "test:e2e": "phpunit --testsuite E2E"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.3",
    "playwright-php/playwright": "^1.4"
  }
}
